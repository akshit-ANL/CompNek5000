c---------------------------------------------------------------------
      subroutine useric(ix,iy,iz,eg)

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      include 'COMPRESS'

      integer ix,iy,iz,eg

      real xx(nspec)
      real yic(nspec)

      real density, intEnergy_mass
      real intE,totE,kinE

      real xx1(nspec)
      real xx2(nspec)
      real xx3(nspec)

      e = gllel(eg)            
      xx(1:nspec) = 0.0

      xx1(1:nspec) = 0.0
      xx2(1:nspec) = 0.0
      xx3(1:nspec) = 0.0

      T1 = 3500.
      T2 = 350.
      T3 = TT0
      p1 = 5.5e5
      p2 = PP0
      p3 = PP0
      xx1(2)  = 0.   ! O2
      xx1(4)  = 0.   ! H2
      xx1(5)  = 0.01 ! OH
      xx1(7)  = 2.   ! H2O
      xx1(10) = 8.   ! Ar
      xx2(2)  = 1.   ! O2
      xx2(4)  = 2.   ! H2
      xx2(5)  = 0.01 ! OH
      xx2(7)  = 0.   ! H2O
      xx2(10) = 7.   ! Ar
      xx3(2)  = 1.   ! O2
      xx3(4)  = 2.   ! H2
      xx3(5)  = 0.   ! OH
      xx3(7)  = 0.   ! H2O
      xx3(10) = 7.   ! Ar

      b = 5000.

      tmpic=(T1-T2)*0.5*(1.-tanh(b*(x-.015)))
     $     +(T2-T3)*0.5*(1.-tanh(b*(x-.025)))
     $     +T3
      pric =(p1-p2)*0.5*(1.-tanh(b*(x-.015)))
     $     +(p2-p3)*0.5*(1.-tanh(b*(x-.025)))
     $     +p3
      do j=1,nspec
        xx(j) = (xx1(j)-xx2(j))*0.5*(1.-tanh(b*(x-.015)))
     $         +(xx2(j)-xx3(j))*0.5*(1.-tanh(b*(x-.025)))
     $          +xx3(j)
      enddo

ccc circular hot spots
      tspot = 3500.
      pspot = 5.5e5
      rset = 0.0025
      b = rset/20.
      xc0 = 0.019
      yc0 = 0.015
      rc = sqrt((x-xc0)**2.+(y-yc0)**2.)
      arg1 = (rset-rc)/b
      tmpic = tmpic + 0.5*(tspot-tmpic)*(1.+tanh(arg1))
      pric = pric + 0.5*(pspot-pric)*(1.+tanh(arg1))
      xc0 = 0.020
      yc0 = 0.044
      rc = sqrt((x-xc0)**2.+(y-yc0)**2.)
      arg1 = (rset-rc)/b
      tmpic = tmpic + 0.5*(tspot-tmpic)*(1.+tanh(arg1))
      pric = pric + 0.5*(pspot-pric)*(1.+tanh(arg1))

      xx(1:nspec) = xx(1:nspec)/sum(xx(1:nspec))

      vxic  = 0.
      vyic  = 0.
      spdic = sqrt(vxic*vxic+vyic*vyic)

ccc rho/Yi
      wmean1 = 0.
      do b=1,nspec
        wmean1 = wmean1 + xx(b)*mw(b)
      enddo
      call eval_EOS_D(pric,rhoic,tmpic,wmean1)
      do b=1,nspec
        yic(b) = xx(b)*mw(b)/wmean1
      enddo

ccc u/e
      intE = 0.
      do b=1,nspec
        j = (b-1)*(npa+1)
        uii = 0.
        do c=1,npa+1
          uii = uii + bi(j+c)*tmpic**(c-1)
        enddo
        intE = intE + yic(b)*uii
      enddo
      kinE = 0.5*spdic**2
      totE = intE+kinE

ccc assign Nek arrays
      if(ifield.eq.(U_EQ+1))then       ! rhoU
         temp = rhoic*vxic
      elseif(ifield.eq.(V_EQ+1))then   ! rhoV
         temp = rhoic*vyic
      elseif(ifield.eq.(W_EQ+1))then   ! rhoW
         temp = rhoic*vzic
      elseif(ifield.eq.(E_EQ+1))then   ! rhoE
         temp = rhoic*totE
      elseif(ifield.ge.(E_EQ+2))then   ! rho*Y_i
         temp = rhoic*yic(ifield-E_EQ-1)
      endif

      vtrans(ix,iy,iz,e,1) = rhoic ! used by check_cons

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk()

      include 'SIZE'
      include 'TOTAL'
      include 'COMPRESS'

      integer n,icout
      
      integer cfreq
      integer bfreq
      integer mfreq
      integer afreq

      n = nx1*ny1*nz1*nelt

      icout = -1

      bfreq = 1.e-7/dt
      cfreq = 1.e-7/dt
      mfreq = 1.e-7/dt
      afreq = 1.e-7/dt

ccc run compressible step
      call runcompdg

ccc output fields
      if(ifoutfld.or.istep.lt.icout) then
         do i=1,n
           t(i,1,1,1,15) = vtrans(i,1,1,1,1)
           t(i,1,1,1,16) = temp1(i,1,1,1)
           t(i,1,1,1,17) = 0.
           do b=1,nspec
             t(i,1,1,1,17) = t(i,1,1,1,17)
     &                      - wdot(i,1,1,1,b)*hh(i,1,1,1,b)
           enddo
           t(i,1,1,1,18) = enmu(i,1,1,1)
           t(i,1,1,1,19) = ss(i,1,1,1)-s0min
         enddo
      endif

ccc numerical soot foil
      do i=1,n
        t(i,1,1,1,20) = max(t(i,1,1,1,20),pr(i,1,1,1))
      enddo

ccc initial conditions
      if(istep.lt.icout) then
         call outpost2(vx,vy,vz,pr,t,ldimt,'ics')
      endif

ccc output time history data
      if(mod(istep,cfreq).eq.0) call check_cons()
      if(mod(istep,bfreq).eq.0) call check_bdry()
      if(mod(istep,mfreq).eq.0) call check_mass()
      if(mod(istep,afreq).eq.0) call check_cons_atom()

      return
      end
c-----------------------------------------------------------------------
      subroutine check_bdry()

      include 'SIZE'
      include 'TOTAL'
      include 'COMPRESS'

      integer e,f

      uul = 0.
      uur = 0.
      uub = 0.
      uut = 0.

      aal = 0.
      aar = 0.
      aab = 0.
      aat = 0.

      do e=1,nelv
      do f=1,2*ndim
        
        nxavg = 0.
        nyavg = 0.
        do i=1,ly1*lz1
          nxavg = nxavg + unx(i,1,f,e)
          nyavg = nyavg + uny(i,1,f,e)
        enddo
        nxavg = nxavg/(ly1*lz1)
        nyavg = nyavg/(lx1*lz1)
        
        if(abs(abs(nxavg)-1.).lt.0.01) then
           call facind2(js1,jf1,jskip1,js2,jf2,jskip2,f)
           xxavg = 0.0
           do j2=js2,jf2,jskip2
           do j1=js1,jf1,jskip1
             xxavg = xxavg+xm1(j1,j2,1,e)
           enddo
           enddo
           xxavg = xxavg/(ly1*lz1)
           if(cbc(f,e,1).eq.'SYM'.and.xxavg.lt.0.05) then         ! left boundary
              call surface_int(uint,aint,vx,e,f)
              uul = uul + uint
              aal = aal + aint
           else if(cbc(f,e,1).eq.'SYM'.and.xxavg.gt.0.05) then    ! right boundary
              call surface_int(uint,aint,vx,e,f)
              uur = uur + uint
              aar = aar + aint
           endif
         
         else if(abs(abs(nyavg)-1.).lt.0.01) then
           call facind2(js1,jf1,jskip1,js2,jf2,jskip2,f)
           yyavg = 0.0
           do j2=js2,jf2,jskip2
           do j1=js1,jf1,jskip1
             yyavg = yyavg+ym1(j1,j2,1,e)
           enddo
           enddo
           yyavg = yyavg/(lx1*lz1)
           if(cbc(f,e,1).eq.'SYM'.and.yyavg.lt.0.03) then        ! bottom boundary
              call surface_int(uint,aint,vy,e,f)
              uub = uub + uint
              aab = aab + aint
           else if(cbc(f,e,1).eq.'SYM'.and.yyavg.gt.0.03) then   ! top boundary
              call surface_int(uint,aint,vy,e,f)
              uut = uut + uint
              aat = aat + aint
           endif

        endif

      enddo
      enddo

      uul = glsum(uul,1)
      uur = glsum(uur,1)
      uub = glsum(uub,1)
      uut = glsum(uut,1)

      aal = glsum(aal,1)
      aar = glsum(aar,1)
      aab = glsum(aab,1)
      aat = glsum(aat,1)

      if(aal.gt.0) vn_left   = uul/aal
      if(aar.gt.0) vn_right  = uur/aar
      if(aab.gt.0) vn_bottom = uub/aab
      if(aat.gt.0) vn_top    = uut/aat 

      if(istep.eq.0.and.nid.eq.0) then
         open(unit=61,file='bdry.dat',status='replace')
         close(61)
      endif

      if(nid.eq.0) then
         open(unit=61,file='bdry.dat',access='append')
         write(61,6) time,vn_left,vn_right,vn_bottom,vn_top
  6      format(E13.5,E15.7,E15.7,E15.7,E15.7)
         close(57)   
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine check_cons()

      include 'SIZE'
      include 'TOTAL'
      include 'COMPRESS'

      common /my_cons/ m0,e0
      real m0,m1,mc
      real e0,e1,ec

      integer n

      n = nx1*ny1*nz1*nelt

      if(istep.eq.0) then
         m0 = glsc2(vtrans(1,1,1,1,1),bm1,n)
         e0 = glsc2(t(1,1,1,1,E_EQ),bm1,n)
         if(nid.eq.0) then
            write(*,*)'m0=',m0
            write(*,*)'e0=',e0
            open(unit=57,file='cons.dat',status='replace')
            close(57)
         endif
      endif

      m1 = glsc2(vtrans(1,1,1,1,1),bm1,n)
      e1 = glsc2(t(1,1,1,1,E_EQ),bm1,n)
      mc = (m0-m1)/m0
      ec = (e0-e1)/e0

      if(nid.eq.0.and.istep.gt.0) then
         open(unit=57,file='cons.dat',access='append')
         write(57,3) time,mc,ec
  3      format(E13.5,E15.7,E15.7)
         close(57)   
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine check_cons_atom()

      include 'SIZE'
      include 'TOTAL'
      include 'COMPRESS'

      common /my_cons_atom/ a0
      real a0(4),a1(4),ac(4)

      real ci(lx1,ly1,lz1,lelt,nspec)
      real ai(lx1,ly1,lz1,lelt,4)

      integer n,b

      integer nelements

      n = nx1*ny1*nz1*nelt

      nelements = 4

      do b=1,nspec
         call copy(ci(1,1,1,1,b),t(1,1,1,1,E_EQ+b),n)
         call cmult(ci(1,1,1,1,b),1./mw(b),n)
      enddo

ccc O
      call rzero(ai(1,1,1,1,1),n)
      call add2s2(ai(1,1,1,1,1),ci(1,1,1,1,1),1.,n)  ! O
      call add2s2(ai(1,1,1,1,1),ci(1,1,1,1,2),2.,n)  ! O2
      call add2s2(ai(1,1,1,1,1),ci(1,1,1,1,5),1.,n)  ! OH
      call add2s2(ai(1,1,1,1,1),ci(1,1,1,1,6),2.,n)  ! HO2
      call add2s2(ai(1,1,1,1,1),ci(1,1,1,1,7),1.,n)  ! H2O
      call add2s2(ai(1,1,1,1,1),ci(1,1,1,1,8),2.,n)  ! H2O2

ccc H
      call rzero(ai(1,1,1,1,2),n)
      call add2s2(ai(1,1,1,1,2),ci(1,1,1,1,3),1.,n)  ! H
      call add2s2(ai(1,1,1,1,2),ci(1,1,1,1,4),2.,n)  ! H2
      call add2s2(ai(1,1,1,1,2),ci(1,1,1,1,5),1.,n)  ! OH
      call add2s2(ai(1,1,1,1,2),ci(1,1,1,1,6),1.,n)  ! HO2
      call add2s2(ai(1,1,1,1,2),ci(1,1,1,1,7),2.,n)  ! H2O
      call add2s2(ai(1,1,1,1,2),ci(1,1,1,1,8),2.,n)  ! H2O2

ccc Ar
      call rzero(ai(1,1,1,1,3),n) 
      call add2s2(ai(1,1,1,1,3),ci(1,1,1,1,10),1.,n) ! Ar

ccc N
      call rzero(ai(1,1,1,1,4),n)
      call add2s2(ai(1,1,1,1,4),ci(1,1,1,1,9),2.,n)  ! N2

      if(istep.eq.0) then
         do c=1,nelements
           a0(c) = glsc2(ai(1,1,1,1,c),bm1,n)
         enddo
         if(nid.eq.0) then
            open(unit=62,file='atom.dat',status='replace')
            close(62)
         endif
      endif

      do c=1,nelements
        a1(c) = glsc2(ai(1,1,1,1,c),bm1,n)
        ac(c) = (a0(c)-a1(c))/a0(c)
      enddo

      if(nid.eq.0.and.istep.gt.0) then
         open(unit=62,file='atom.dat',access='append')
         write(62,3) time,ac(1),ac(2),ac(3),ac(4)
  3      format(E13.5,E15.7,E15.7,E15.7,E15.7)
         close(62)   
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine check_mass()

      include 'SIZE'
      include 'TOTAL'
      include 'COMPRESS'

      real ymin(lx1,ly1,lz1,lelt)
      real ysum(lx1,ly1,lz1,lelt)
      real wdotsum(lx1,ly1,lz1,lelt)

      integer n

      n = nx1*ny1*nz1*nelt

      if(istep.eq.0.and.nid.eq.0) then
         open(unit=56,file='mass.dat',status='replace')
         close(56)
      endif
      
      do i=1,n
        ysum(i,1,1,1) = 0.
        wdotsum(i,1,1,1) = 0.
        ymin(i,1,1,1) = 1.
        do b=1,nspec
          yy = t(i,1,1,1,E_EQ+b)/vtrans(i,1,1,1,1)
          ysum(i,1,1,1) = ysum(i,1,1,1) + yy
          wdotsum(i,1,1,1) = wdotsum(i,1,1,1) + wdot(i,1,1,1,b)
          if(yy.lt.ymin(i,1,1,1)) ymin(i,1,1,1) = yy
        enddo
      enddo

      yy_min   = glmin(ymin,n)
      ysum_min = glmin(ysum,n)
      ysum_max = glmax(ysum,n)
      wdotsum_min = glmin(wdotsum,n)
      wdotsum_max = glmax(wdotsum,n)

      if(nid.eq.0) then
         open(unit=56,file='mass.dat',access='append')
         write(56,4) time,yy_min,ysum_min,ysum_max
     $                    ,wdotsum_min,wdotsum_max
4        format(E13.5,E15.7,E15.7,E15.7,E15.7,E15.7)
         close(56)
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userqtl

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat()

      include 'SIZE'
      include 'TOTAL'
      include 'COMPRESS'

      character*20 sname
      integer b

ccc initiate Cantera
      call newIdealGasMix('hydrogen_34.yaml',
     $                    'gas','mixture-averaged')
      call getmolecularweights(mw)
      if(nid.eq.0) write(*,*) 'species       mol wt'
      do i=1,nspec
        mw(i) = mw(i)*1.e-3
        call getSpeciesName(i, sname)
        if(nid.eq.0) then
           write(*,3) i,sname,mw(i)
  3        format (I6.2,' ',a7,F7.4)
        endif 
      enddo

ccc refit of NASA-7 polynomials
      open(unit=202,file='aa.dat',form='formatted',status='old')
      read(202,*) aa
      close(202)

ccc reference enthalpy @ 298.15 K
      open(unit=203,file='h0.dat',form='formatted',status='old')
      read(203,*) h0
      close(203)

ccc standard entropy @ 298.15 K and Patm=101325
      open(unit=204,file='s0.dat',form='formatted',status='old')
      read(204,*) s0
      close(204)

ccc calculate bi array for interal energy
      call get_bi()

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2()

      include 'SIZE'
      include 'TOTAL'

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3()

      include 'SIZE'
      include 'TOTAL'
      include 'COMPRESS'

      ifflow = .false.      ! required for Nek interface
      ifheat = .true.       ! required for Nek interface
      ifdg   = .true.       ! required for Nek interface

      ifviscous    = .false. ! viscous terms
      ifforces     = .true.  ! user forces
      ifavisc      = .true.  ! artificial viscosity
      ifsplitchem  = .true.  ! Strang splitting
      ifclip       = .false. ! clip mass fractions/temp
      if1D         = .false. ! force 1D
      ifpplim      = .true.  ! positivity-preserving limiter
      ifIntLLFfull = .false. ! full LLF in interface term
      ifVolEC      = .false. ! EC volume terms

      return
      end
