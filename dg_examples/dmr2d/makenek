#!/bin/bash
set -a
#-------------------------------------------------------------------------------
# Nek5000 config -- Cantera-free build (stock nekconfig path)
#-------------------------------------------------------------------------------

# source path
: ${NEK_SOURCE_ROOT:="$HOME/CompNek5000"}

# Fortran/C compiler
FC="mpif77"
CC="mpicc"

# config options (set to "?" to get a list)
PPLIST="PARRSB HYPRE"

# optional compiler flags
FFLAGS="-g -ffixed-line-length-132 -I$NEK_SOURCE_ROOT/src"

# auxilliary files to compile (makefile_usr.inc provides the build rules)
USR="runcomp.o compcfl.o rungeKutta.o dgdiv.o dgrhs.o compvar.o fluxLF.o entrovisc.o compbc.o viscous.o compf.o advect.o cantera_stubs.o"

###############################################################################
# DONT'T TOUCH WHAT FOLLOWS !!!
###############################################################################
echo "using source path: $NEK_SOURCE_ROOT"
VERMAKENEK="19.0.1"
set +a -e
$NEK_SOURCE_ROOT/bin/nekconfig $@
if [[ $1 != "clean" ]]; then
 $NEK_SOURCE_ROOT/bin/nekconfig -build-dep
 set -o pipefail
 touch $1.usr
 make -j4 2>&1 | tee -a build.log
 set +o pipefail
fi
